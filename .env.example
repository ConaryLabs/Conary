# Conary project environment variables
# Copy only the values needed for the task into an ignored .env file.
# Never commit a populated .env file.

# Public Remi package API. packages.conary.io remains a compatibility alias.
REMI_ENDPOINT=https://remi.conary.io

# Maintainer-only Remi administration. Keep the admin listener private and set
# this to a direct origin URL or an SSH-tunnel URL such as
# http://localhost:8082. Do not point it at a public :8082 endpoint.
REMI_ADMIN_ENDPOINT=
REMI_ADMIN_TOKEN=
