{
  "name": "conary-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "bash ../scripts/sync-brand.sh",
    "dev": "vite dev",
    "prebuild": "bash ../scripts/sync-brand.sh",
    "build": "vite build && npm run verify:build",
    "preview": "vite preview",
    "precheck": "bash ../scripts/sync-brand.sh",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "verify:build": "node scripts/verify-build.mjs",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.70.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "^26.1.2",
    "svelte": "^5.56.8",
    "svelte-check": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "chart.js": "^4.4.7"
  },
  "overrides": {
    "cookie": "0.7.2"
  },
  "type": "module"
}
