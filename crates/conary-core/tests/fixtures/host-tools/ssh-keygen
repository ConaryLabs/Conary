#!/bin/sh
set -eu

key_path=
while [ "$#" -gt 0 ]; do
    case "$1" in
        -f)
            key_path=$2
            shift 2
            ;;
        *)
            shift
            ;;
    esac
done

mkdir -p "$(dirname "$key_path")"
printf 'fake-private-key\n' > "$key_path"
printf 'ssh-ed25519 AAAATESTKEY generated-by-test\n' > "$key_path.pub"
