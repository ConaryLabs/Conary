[Unit]
Description=GitHub Actions Runner (Conary trusted Remi CI capacity)
Wants=network-online.target
After=network-online.target user@__RUNNER_UID__.service

[Service]
User=conary-ci
Group=conary-ci
WorkingDirectory=/data/conary-ci/actions-runner
ExecStart=/data/conary-ci/actions-runner/runsvc.sh
Restart=always
RestartSec=5s
KillMode=process
KillSignal=SIGTERM
TimeoutStopSec=5min
UMask=0077
PrivateTmp=true
ProtectSystem=full
InaccessiblePaths=-/conary/repository-keys -/conary/deployment-backups
TasksMax=infinity
Environment=HOME=/data/conary-ci
Environment=PATH=/data/conary-ci/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=RUSTUP_HOME=/data/conary-ci/.rustup
Environment=XDG_RUNTIME_DIR=/run/user/__RUNNER_UID__
Environment=DOCKER_HOST=unix:///run/user/__RUNNER_UID__/podman/podman.sock
Environment=CONARY_CI_CACHE_ROOT=/data/conary-ci/cache
Environment=CONARY_CI_RUNNER_IDENTITY=conary-ci

[Install]
WantedBy=multi-user.target
